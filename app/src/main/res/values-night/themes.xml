<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色（Night）变体：与 values/themes.xml 的 Theme.KittyIDE 同名覆盖 -->
    <style name="Theme.KittyIDE" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:colorBackground">@color/window_background_dark</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>
